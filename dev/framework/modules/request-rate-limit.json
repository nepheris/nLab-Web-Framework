    "date_creation": "2026-09-20",
    "date_mise_a_jour": "2026-09-20",
    "help_id": "HELP_REQUEST_RATE_LIMIT",
    "category": "security",
    "tags": ["security", "rate-limit", "quota", "apps-script", "cache"],
    "visibility": ["dev"],
    "supported_runtime_modes": ["production", "local"]
  },
  "Data": {
    "purpose": "Limiter les appels applicatifs avant les opérations coûteuses afin de protéger Apps Script, Drive et les quotas associés.",
    "defaults": {
      "requests_per_minute": 30,
      "requests_per_hour": 300
    },
    "storage": "CacheService.getScriptCache",
    "concurrency_control": "LockService.getScriptLock",
    "rules": [
      "Rate limiting is enforced server-side.",
      "Limits are configuration, not UI hints.",
      "The limiter runs before Drive reads and writes whenever possible.",
      "UI clients aggregate reads and never issue one remote call per keystroke.",
      "429 responses include a retry_after_seconds value."
    ]
  },
  "dictionnaire_donnees": {
    "generated_from_schema": "SCH_MODULE",
    "note": "Fenêtres minute/heure volontairement simples et réutilisables."
  }
}
