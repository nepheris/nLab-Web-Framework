        "variant": "compact",
        "width": "content",
        "max_height": "25vh",
        "radius": "lg",
        "shadow": "soft",
        "gradient": "theme",
        "foldable": false
      },
      "section_index": {
        "foldable": true,
        "help": true
      },
      "header_navigation": {
        "sticky": true
      },
      "application_shell": {
        "header_mode": "sticky",
        "header_visible": true,
        "header_shadow": true,
        "header_compact": false,
        "header_auto_hide": false,
        "default_view": "cards",
        "allowed_views": [
          "cards",
          "list",
          "gallery"
        ],
        "floating_windows": [
          "navigation",
          "help",
          "settings"
        ],
        "local_preferences": true,
        "themeable_svg_currentColor": true
      },
      "footer": {
        "release_metadata": true,
        "dynamic_version_source": true,
        "show_build_ref": true,
        "expandable_inventory": true
      }
    },
    "business_slots": [
