    "pattern_registry": "pattern-registry.json",
    "rules": [
      "Business data and project labels stay outside framework components.",
      "Primitive mechanics are composed, never copied.",
      "All actions reference stable button IDs.",
      "Visual styling comes from semantic tokens and themes.",
      "Provider-specific behavior remains in adapters.",
      "Public help wording comes from the help registry; Dev facts are generated.",
      "Canonical registry paths are resolved from framework-manifest.json.",
      "A new component must justify behavior that cannot be assembled from registered primitives.",
      "Field rendering and input behavior are configured through shared registries rather than recoded per editor or form."
    ]
